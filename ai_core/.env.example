APP_NAME="WhatsApp Executive Assistant AI"
DEBUG=True
DATABASE_URL="sqlite:///./assistant.db"
OPENAI_API_KEY=

# Browser origins allowed to call this API.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Shared with wa_worker/.env. The WhatsApp worker sends this header.
# Generate a long random value. Do not put it in the frontend.
WORKER_INTERNAL_SECRET=

# Firebase Admin SDK — server only.
# Copy these three fields from the service account JSON
# (Firebase console → Project settings → Service accounts → Generate new private key).
# Keep the private key in double quotes, with \n between the PEM lines.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional. Comma-separated Gmail addresses allowed to sign in.
# Leave empty to allow any Google account in this Firebase project.
FIREBASE_ALLOWED_EMAILS=
